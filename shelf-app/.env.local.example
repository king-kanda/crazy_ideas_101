NEXT_PUBLIC_API_URL=https://shelf-7a6211a30e15.herokuapp.com

# ── Auth.js v5 (Google OAuth) ────────────────────────────────────
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth client — from Google Cloud Console → APIs & Services → Credentials.
# The Google provider (next-auth/providers/google) reads these AUTH_-prefixed names.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# In production, set this to your deployed origin (Auth.js infers it locally in dev).
# AUTH_URL=https://app.paldacommerce.com

# ── Meta Embedded Signup (Phase 2) ──────────────────────────────
# App ID is public (ships to the browser); client secret stays on the API.
NEXT_PUBLIC_META_APP_ID=
# Meta Graph API version to pin the ES SDK to.
NEXT_PUBLIC_META_GRAPH_VERSION=v19.0
# Config IDs from Meta → App Dashboard → WhatsApp / IG / FB → ES configuration.
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=
NEXT_PUBLIC_META_INSTAGRAM_CONFIG_ID=
NEXT_PUBLIC_META_FACEBOOK_CONFIG_ID=
