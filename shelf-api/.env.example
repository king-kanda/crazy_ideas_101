DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/shelf
REDIS_URL=redis://localhost:6379
GROQ_API_KEY=your_groq_api_key
JWT_SECRET=your_jwt_secret_here

# Token-at-rest encryption (Fernet key). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Meta Embedded Signup (Phase 2)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v19.0
META_REDIRECT_URI=
# Shared secret for Meta's webhook subscription handshake (hub.verify_token)
META_WEBHOOK_VERIFY_TOKEN=
